<div class="detail">
  <div class="gallery">
    <div class="main"><img id="main-img" src="<%= images[0] %>" alt="<%= product.title %>"></div>
    <% if (images.length > 1) { %>
    <div class="thumbs">
      <% images.forEach((src, i) => { %><button type="button" aria-label="Show image <%= i + 1 %>" onclick="document.getElementById('main-img').src=this.querySelector('img').src"><img src="<%= src %>" alt=""></button><% }) %>
    </div>
    <% } %>
  </div>
  <div class="stack">
    <p class="tag"><%= [product.brand, product.category].filter(Boolean).join(' · ') %></p>
    <h1><%= product.title %></h1>
    <div class="price" style="font-size:1.6rem"><%= money(product.price) %></div>
    <p><%= product.description %></p>
    <% if (product.stock < 1) { %><p class="stock-out">Out of stock</p>
    <% } else { %>
      <% if (product.stock <= 3) { %><p class="stock-low">Only <%= product.stock %> left</p><% } else { %><p class="muted small">In stock</p><% } %>
      <form method="post" action="/cart/add" class="row">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <label class="sr" for="qty">Quantity</label>
        <input class="qty" id="qty" type="number" name="qty" value="1" min="1" max="<%= Math.min(product.stock, 10) %>">
        <button class="btn-primary">Add to cart</button>
      </form>
    <% } %>
    <p class="small muted">Pay on delivery or M-Pesa · Delivery across Kenya</p>
  </div>
</div>
<% if (related.length) { %>
<section class="section">
  <h2 style="margin-bottom:1rem">You may also like</h2>
  <div class="grid"><% related.forEach(p => { %><%- include('partials/product-card', { p, csrfToken, money }) %><% }) %></div>
</section>
<% } %>
